BOT_TOKEN=123456:replace_me
PAIR_CODE=replace-with-a-long-random-secret
DOWNLOAD_DIR=./downloads
DB_PATH=./data/bot.db
LOCAL_BOT_API_URL=
LOG_LEVEL=INFO
MAX_DOWNLOAD_RETRIES=3

# Saved Messages source, used by: telegram-archiver saved
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELEGRAM_SESSION=./data/saved_messages.session
TEXT_DOWNLOAD_DIR=./downloads/texts
SAVED_ARCHIVE_EXISTING=true
SAVED_BLOCKED_FORWARD_CHAT_IDS=
TELETHON_PROXY=

# Saved Messages recovery/rescan settings
SAVED_RETRY_PARTIALS_ON_START=true
SAVED_RETRY_PARTIALS_LIMIT=0
SAVED_RECENT_SCAN_INTERVAL_SECONDS=900
SAVED_RECENT_SCAN_LIMIT=2000

# Channel source, used by: telegram-archiver channels
# Use peers from `telegram-archiver channels-list`, for example -1002683725559 or @public_channel.
CHANNEL_ARCHIVE_PEERS=
CHANNEL_TELEGRAM_SESSION=./data/channel_archiver.session
CHANNEL_ARCHIVE_EXISTING=true
CHANNEL_ARCHIVE_EXTENSIONS=
CHANNEL_ARCHIVE_TEXT=true
CHANNEL_ARCHIVE_PASSWORD_FILE=
CHANNEL_STRIP_ARCHIVE_PASSWORDS=false
CHANNEL_RETRY_PARTIALS_ON_START=true
CHANNEL_RETRY_PARTIALS_LIMIT=0
CHANNEL_RECENT_SCAN_INTERVAL_SECONDS=900
CHANNEL_RECENT_SCAN_LIMIT=2000
